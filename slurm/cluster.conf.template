# =============================================================================
# Cluster-specific SLURM configuration
#
# Copy this file to slurm/cluster.conf and uncomment the block for your cluster:
#   cp slurm/cluster.conf.template slurm/cluster.conf
#
# slurm/cluster.conf is gitignored — each user/cluster keeps its own copy.
# =============================================================================

# ---- Viper (AMD GPUs) -------------------------------------------------------
CLUSTER_PARTITION="apu"
CLUSTER_PARTITION_DEV="apudev"
CLUSTER_GPU_GRES_2="gpu:2"
CLUSTER_GPU_GRES_1="gpu:1"
CLUSTER_ACCOUNT="mpp_apu"
PIXI_ENV="rocm"

